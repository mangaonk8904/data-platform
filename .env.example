# Copy to .env and fill in. Never commit .env or private keys.
SNOWFLAKE_ACCOUNT=         # e.g. abcdefg-xy12345 (orgname-accountname)
SNOWFLAKE_USER=            # bootstrap user (trial admin)
SNOWFLAKE_PASSWORD=        # only used for Phase 0 bootstrap; we switch to key-pair auth
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=WH_ADMIN
# Set after Phase 0 key-pair setup:
SNOWFLAKE_PRIVATE_KEY_PATH=keys/rsa_key.p8
